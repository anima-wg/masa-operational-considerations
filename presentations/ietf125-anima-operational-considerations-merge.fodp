      <text:p text:style-name="P34"><text:span text:style-name="T23"><text:s text:c="7"/>Recommendations for the Registrar</text:span></text:p>
      <text:p text:style-name="P34"><text:span text:style-name="T23"><text:s text:c="5"/>3.1. <text:s/>PKI recommendations </text:span></text:p>
      <text:p text:style-name="P34"><text:span text:style-name="T23"><text:s text:c="11"/>for Tier-1/ISP Networks</text:span></text:p>
      <text:p text:style-name="P34"><text:span text:style-name="T23"><text:s text:c="5"/>3.2. <text:s/>Enterprise Network</text:span></text:p>
