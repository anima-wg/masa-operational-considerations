   <draw:page draw:name="page9" draw:style-name="dp5" draw:master-page-name="Title_20_and_20_Content" presentation:presentation-page-layout-name="AL2T3" presentation:use-footer-name="ftr1" presentation:use-date-time-name="dtd1">
    <office:forms form:automatic-focus="false" form:apply-design-mode="false"/>
    <draw:frame presentation:style-name="pr12" draw:text-style-name="P21" draw:layer="layout" svg:width="30.832cm" svg:height="6.343cm" svg:x="2.646cm" svg:y="1.061cm" presentation:class="title" presentation:user-transformed="true">
     <draw:text-box>
      <text:p text:style-name="P20"><text:span text:style-name="T27">Merged Table Of Contents</text:span><text:span text:style-name="T27"><text:line-break/></text:span><text:span text:style-name="T27">Operational Only</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame presentation:style-name="pr13" draw:text-style-name="P36" draw:layer="layout" svg:width="15.046cm" svg:height="17.461cm" svg:x="2.646cm" svg:y="7.232cm" presentation:class="outline">
     <draw:text-box>
      <text:p text:style-name="P34"><text:span text:style-name="T23"><text:s text:c="3"/>1. <text:s/>Introduction</text:span></text:p>
      <text:p text:style-name="P34"><text:span text:style-name="T23"><text:s text:c="5"/>1.1. <text:s/>Terminology</text:span></text:p>
      <text:p text:style-name="P34"><text:span text:style-name="T23"><text:s text:c="5"/>1.2. <text:s/>Reference Network and Diagrams</text:span></text:p>
      <text:p text:style-name="P34"><text:span text:style-name="T23"><text:s text:c="7"/>1.2.1. <text:s/>Tier-1 Network</text:span></text:p>
      <text:p text:style-name="P34"><text:span text:style-name="T23"><text:s text:c="7"/>1.2.2. <text:s/>Enterprise Network</text:span></text:p>
