    <draw:frame presentation:style-name="pr13" draw:layer="layout" svg:width="15.046cm" svg:height="17.461cm" svg:x="18.445cm" svg:y="7.932cm" presentation:class="outline" presentation:user-transformed="true">
     <draw:text-box>
      <text:p text:style-name="P28"><text:span text:style-name="T21">Registrar</text:span></text:p>
      <text:p text:style-name="P28"><text:span text:style-name="T12"/></text:p>
      <text:p text:style-name="P28"><text:span text:style-name="T12"/></text:p>
      <text:p text:style-name="P28"><text:span text:style-name="T12"><text:s text:c="3"/>3. <text:s/>Public Key Infrastructure</text:span></text:p>
      <text:p text:style-name="P28"><text:span text:style-name="T12"><text:s text:c="7"/>Recommendations for the Registrar</text:span></text:p>
      <text:p text:style-name="P28"><text:span text:style-name="T12"><text:s text:c="5"/>3.1. <text:s/>PKI recommendations </text:span></text:p>
      <text:p text:style-name="P28"><text:span text:style-name="T12"><text:s text:c="11"/>for Tier-1/ISP Networks</text:span></text:p>
      <text:p text:style-name="P28"><text:span text:style-name="T12"><text:s text:c="5"/>3.2. <text:s/>Enterprise Network</text:span></text:p>
      <text:p text:style-name="P28"><text:span text:style-name="T12"><text:s text:c="5"/>3.3. <text:s/>Home Network</text:span></text:p>
      <text:p text:style-name="P28"><text:span text:style-name="T12"/></text:p>
      <text:p text:style-name="P28"><text:span text:style-name="T12"/></text:p>
      <text:p text:style-name="P28"><text:span text:style-name="T12"/></text:p>
      <text:p text:style-name="P28"><text:span text:style-name="T14"><text:s text:c="3"/>5. <text:s/>Certificates needed for the Registrar</text:span></text:p>
      <text:p text:style-name="P28"><text:span text:style-name="T14"><text:s text:c="5"/>5.1. <text:s/>TLS Server Certificate for BRSKI-EST</text:span></text:p>
      <text:p text:style-name="P28"><text:span text:style-name="T14"><text:s text:c="5"/>5.2. <text:s/>TLS Client Certificate for </text:span></text:p>
      <text:p text:style-name="P28"><text:span text:style-name="T14"><text:s text:c="15"/>BRSKI-MASA</text:span></text:p>
      <text:p text:style-name="P28"><text:span text:style-name="T14"><text:s text:c="7"/>5.2.1. <text:s/>Use of Publically Anchored </text:span></text:p>
      <text:p text:style-name="P28"><text:span text:style-name="T14"><text:s text:c="15"/>TLS Client Certificate with</text:span></text:p>
      <text:p text:style-name="P28"><text:span text:style-name="T14"><text:s text:c="15"/>BRSKI-MASA connection</text:span></text:p>
      <text:p text:style-name="P28"><text:span text:style-name="T14"><text:s text:c="5"/>5.3. <text:s/>Certificate for signing of </text:span></text:p>
      <text:p text:style-name="P28"><text:span text:style-name="T14"><text:s text:c="11"/>Voucher-Requests</text:span></text:p>
      <text:p text:style-name="P28"><text:span text:style-name="T14"/></text:p>
      <text:p text:style-name="P28"><text:span text:style-name="T13"/></text:p>
     </draw:text-box>
