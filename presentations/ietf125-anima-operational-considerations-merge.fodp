      <text:p text:style-name="P34"><text:span text:style-name="T28"/></text:p>
      <text:p text:style-name="P35"><text:span text:style-name="T23"><text:s text:c="3"/>2. <text:s/>Operational Considerations for Manufacturer Authorized </text:span><text:span text:style-name="T23">Signing</text:span></text:p>
      <text:p text:style-name="P35"><text:span text:style-name="T23"><text:s text:c="11"/>Authority (MASA)</text:span></text:p>
      <text:p text:style-name="P35"><text:span text:style-name="T23"><text:s text:c="5"/>2.1. <text:s/>Deflecting unwanted TLS </text:span></text:p>
      <text:p text:style-name="P35"><text:span text:style-name="T23"><text:s text:c="11"/>traffic with Client</text:span></text:p>
      <text:p text:style-name="P35"><text:span text:style-name="T23"><text:s text:c="11"/>Certificates</text:span></text:p>
      <text:p text:style-name="P35"><text:span text:style-name="T23"><text:s text:c="5"/>2.2. <text:s/>Web framework architecture</text:span></text:p>
      <text:p text:style-name="P35"><text:span text:style-name="T23"><text:s text:c="5"/>2.3. <text:s/>Self-contained multi-product MASA,</text:span></text:p>
      <text:p text:style-name="P35"><text:span text:style-name="T23"><text:s text:c="12"/>no PKI</text:span></text:p>
      <text:p text:style-name="P35"><text:span text:style-name="T23"><text:s text:c="5"/>2.4. <text:s/>Self-contained multi-product MASA,</text:span></text:p>
      <text:p text:style-name="P35"><text:span text:style-name="T23"><text:s text:c="12"/>with one-level PKI</text:span></text:p>
      <text:p text:style-name="P35"><text:span text:style-name="T23"><text:s text:c="5"/>2.5. <text:s/>Self-contained per-product MASA</text:span></text:p>
      <text:p text:style-name="P35"><text:span text:style-name="T23"><text:s text:c="5"/>2.6. <text:s/>Per-product MASA keys intertwined</text:span></text:p>
      <text:p text:style-name="P35"><text:span text:style-name="T23"><text:s text:c="12"/>with IDevID PKI</text:span></text:p>
      <text:p text:style-name="P35"><text:span text:style-name="T23"><text:s text:c="5"/>2.7. <text:s/>Rotating MASA authorization keys</text:span></text:p>
      <text:p text:style-name="P35"><text:span text:style-name="T23"><text:s text:c="3"/>3. <text:s/>Operational Considerations for</text:span></text:p>
