    <draw:frame presentation:style-name="pr13" draw:layer="layout" svg:width="15.046cm" svg:height="17.461cm" svg:x="18.445cm" svg:y="7.232cm" presentation:class="outline">
     <draw:text-box>
      <text:list text:style-name="L3">
       <text:list-item>
        <text:p><text:span text:style-name="T26">This section/diagram was added with the intention of providing advice about </text:span><text:span text:style-name="T26">how to deal with network and database partitions</text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p><text:span text:style-name="T26">Can we onboard devices (like, core routing platforms needed to repair the </text:span><text:span text:style-name="T26">partition!) when there are partitions? <text:s/>What preperations are necessary? </text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p><text:span text:style-name="T26">Maybe this section was too ambitious?</text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p><text:span text:style-name="T26"/></text:p>
       </text:list-item>
      </text:list>
     </draw:text-box>
