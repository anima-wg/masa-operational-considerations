     <draw:frame presentation:style-name="pr14" draw:text-style-name="P26" draw:layer="layout" svg:width="15.239cm" svg:height="11.429cm" svg:x="1.905cm" svg:y="12.065cm" presentation:class="notes" presentation:placeholder="true">
